---
import { SITE_TITLE } from '../consts';
import ThemeToggle from './ThemeToggle.astro';
import Icon from './Icon.astro';

const path = Astro.url.pathname;
const isHome = path === '/';
---

<header class="site-nav">
  <div class="container nav-inner">
    <a href="/" class="brand" aria-label={`${SITE_TITLE} — home`}>
      <span class="brand-prompt">~/</span>saba.codes
    </a>
    <nav class="nav-links" aria-label="Primary">
      <a href="/" class:list={['nav-link', isHome && 'active']}>Home</a>
      <a
        href="/rss.xml"
        class="nav-link nav-icon"
        aria-label="RSS feed"
        title="RSS feed"
      >
        <Icon name="rss" size={16} />
      </a>
      <ThemeToggle />
    </nav>
  </div>
</header>

<style>
  .site-nav {
    position: sticky;
    top: 0;
    z-index: 20;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: saturate(180%) blur(8px);
    border-bottom: 1px solid var(--border);
  }
  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 3.5rem;
  }
  .brand {
    font-weight: 700;
    color: var(--text);
    letter-spacing: -0.02em;
  }
  .brand:hover {
    text-decoration: none;
    color: var(--accent);
  }
  .brand-prompt {
    color: var(--accent);
  }
  .nav-links {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .nav-link {
    color: var(--text-muted);
    font-size: 0.9rem;
    display: inline-flex;
    align-items: center;
  }
  .nav-link:hover,
  .nav-link.active {
    color: var(--accent);
    text-decoration: none;
  }
  .nav-icon {
    padding: 0.2rem;
  }
</style>
