---
import { Image } from 'astro:assets';
import BaseLayout from './BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Icon from '../components/Icon.astro';
import { slugifyTag } from '../lib/utils';
import { SITE_TITLE } from '../consts';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  tags?: string[];
  heroImage?: ImageMetadata;
  heroAlt?: string;
  minutesRead?: string;
}
const {
  title,
  description,
  pubDate,
  updatedDate,
  tags = [],
  heroImage,
  heroAlt,
  minutesRead,
} = Astro.props;
---

<BaseLayout
  title={`${title} — ${SITE_TITLE}`}
  description={description}
  type="article"
  image={heroImage?.src}
  publishedTime={pubDate}
>
  <article class="post prose">
    <a href="/" class="back-link">
      <Icon name="arrow-left" size={15} /> All posts
    </a>

    <header class="post-header">
      <h1>{title}</h1>
      <div class="post-meta">
        <span class="meta-item">
          <Icon name="calendar" size={14} />
          <FormattedDate date={pubDate} />
        </span>
        {
          minutesRead && (
            <span class="meta-item">
              <Icon name="clock" size={14} />
              {minutesRead}
            </span>
          )
        }
        {
          updatedDate && (
            <span class="meta-item meta-updated">
              Updated <FormattedDate date={updatedDate} />
            </span>
          )
        }
      </div>
      {
        tags.length > 0 && (
          <div class="post-tags">
            {tags.map((t) => (
              <a class="tag" href={`/tags/${slugifyTag(t)}/`}>
                #{t}
              </a>
            ))}
          </div>
        )
      }
    </header>

    {
      heroImage && (
        <Image
          src={heroImage}
          alt={heroAlt ?? title}
          class="post-hero"
          widths={[480, 800, 1200]}
          sizes="(max-width: 46rem) 100vw, 46rem"
        />
      )
    }

    <div class="post-body">
      <slot />
    </div>
  </article>
</BaseLayout>

<style>
  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.85rem;
    color: var(--text-muted);
    margin: 1.5rem 0 1.25rem;
  }
  .back-link:hover {
    color: var(--accent);
    text-decoration: none;
  }
  .post-header {
    margin-bottom: 1.5rem;
  }
  .post-header h1 {
    margin-bottom: 0.75rem;
  }
  .post-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.1rem;
    font-size: 0.82rem;
    color: var(--text-faint);
    margin-bottom: 0.75rem;
  }
  .meta-item {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }
  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .post-hero {
    width: 100%;
    height: auto;
    border-radius: var(--radius);
    border: 1px solid var(--border);
    margin-bottom: 1.75rem;
  }
</style>

<script>
  // Add a "Copy" button to every highlighted code block (not Mermaid diagrams).
  document
    .querySelectorAll<HTMLElement>('.post-body pre.astro-code')
    .forEach((pre) => {
      const wrapper = document.createElement('div');
      wrapper.className = 'code-wrap';
      pre.parentNode?.insertBefore(wrapper, pre);
      wrapper.appendChild(pre);

      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'copy-code';
      btn.textContent = 'Copy';
      btn.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(pre.innerText);
          btn.textContent = 'Copied';
          btn.classList.add('copied');
          setTimeout(() => {
            btn.textContent = 'Copy';
            btn.classList.remove('copied');
          }, 1500);
        } catch {
          /* clipboard unavailable */
        }
      });
      wrapper.appendChild(btn);
    });
</script>
