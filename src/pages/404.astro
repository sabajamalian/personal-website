---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404 — Not found" description="This page could not be found.">
  <section class="notfound">
    <p class="code">404</p>
    <h1>Page not found</h1>
    <p class="msg">The page you were looking for isn't here.</p>
    <a href="/" class="btn">Back home</a>
  </section>
</BaseLayout>

<style>
  .notfound {
    text-align: center;
    padding: 4rem 0;
  }
  .code {
    font-size: 4rem;
    font-weight: 700;
    color: var(--accent);
    line-height: 1;
  }
  .notfound h1 {
    margin: 0.5rem 0;
  }
  .msg {
    color: var(--text-muted);
    margin-bottom: 1.5rem;
  }
</style>
