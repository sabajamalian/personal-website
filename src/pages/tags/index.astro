---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { sortPosts, collectTags } from '../../lib/utils';
import { SITE_TITLE } from '../../consts';

const posts = sortPosts(await getCollection('blog'));
const tags = collectTags(posts);
---

<BaseLayout title={`Tags — ${SITE_TITLE}`} description="Browse posts by topic.">
  <h1 class="tags-title">Tags</h1>
  {
    tags.length === 0 ? (
      <p class="empty">No tags yet.</p>
    ) : (
      <div class="tag-cloud">
        {tags.map((t) => (
          <a href={`/tags/${t.slug}/`} class="tag tag-lg">
            #{t.tag}
            <span class="tag-count">{t.count}</span>
          </a>
        ))}
      </div>
    )
  }
</BaseLayout>

<style>
  .tags-title {
    margin: 2rem 0 1.25rem;
  }
  .tag-cloud {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }
  .tag-lg {
    font-size: 0.9rem;
    padding: 0.3rem 0.7rem;
  }
  .tag-count {
    margin-left: 0.35rem;
    opacity: 0.7;
    font-size: 0.8em;
  }
  .empty {
    color: var(--text-muted);
    padding: 1rem 0;
  }
</style>
